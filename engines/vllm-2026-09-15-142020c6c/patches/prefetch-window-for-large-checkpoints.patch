+def _prefetch_window(
+    sorted_files: list[str],
+    window: int,
+    block_size: int,
+    max_bytes: int,
+) -> Generator[str, None, None]:
+    """Yield checkpoint files, keeping the ones the loader is about to reach in the page cache.
+
+    The loader faults its weights in one tensor at a time, between host-to-device copies, so a
+    shard is read at the rate of a single thread that stops on every copy. The reads here run on
+    `window` threads that do not stop, ahead of the file being loaded, which is both parallel and
+    overlapped with the copies. Unlike a prefetch of the whole checkpoint, the read-ahead is
+    bounded -- by `window` files and by `max_bytes` -- so a checkpoint larger than the page cache
+    is not read into pages that are evicted before the loader arrives. A shard larger than
+    `max_bytes` on its own is still read whole, since the loader is about to read it anyway.
+    """
+    sizes = [os.path.getsize(path) for path in sorted_files]
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=window) as pool:
+        reads: dict[int, concurrent.futures.Future] = {}
+        queued_bytes = 0
+        next_file = 0
+
+        for index, path in enumerate(sorted_files):
+            while (
+                next_file < len(sorted_files)
+                and len(reads) < window
+                and (not reads or queued_bytes + sizes[next_file] <= max_bytes)
+            ):
+                reads[next_file] = pool.submit(
+                    _prefetch_checkpoint, sorted_files[next_file], block_size
+                )
+                queued_bytes += sizes[next_file]
+                next_file += 1
+
+            queued_bytes -= sizes[index]
+            try:
+                reads.pop(index).result()
+            except Exception:
+                logger.warning(
+                    "Failed to prefetch checkpoint file %r.", path, exc_info=True
+                )
+            yield path
+
+
