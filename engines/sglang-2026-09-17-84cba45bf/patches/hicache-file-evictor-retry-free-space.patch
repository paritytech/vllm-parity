+    def _warn_refusal(self, message: str) -> None:
+        """Log a refused write, at most once every REFUSAL_LOG_INTERVAL_SECONDS.
+
+        A refusal is per file and a page backup writes one file per pool component, so a
+        filesystem sitting at the watermark produces thousands of these a minute, in which
+        state the interesting number is how many rather than which key. Caller holds _lock.
+        """
+        now = time.monotonic()
+        if now - self._last_refusal_log < REFUSAL_LOG_INTERVAL_SECONDS:
+            self._refusals_suppressed += 1
+            return
+        if self._refusals_suppressed:
+            message += (
+                f" ({self._refusals_suppressed} further refusals in the last "
+                f"{now - self._last_refusal_log:.0f}s)"
+            )
+        self._last_refusal_log = now
+        self._refusals_suppressed = 0
+        logger.warning(message)
+
     def _enforce_free_space_locked(self, value_bytes: int) -> bool:
         """Evict until writing value_bytes still leaves min_free_bytes free.
-        Caller holds _lock. Returns False if the write can't be satisfied."""
+        Caller holds _lock. Returns False if the write can't be satisfied.
+
+        The first round overshoots the watermark by the same fraction the cap path leaves
+        below its cap, and each round re-probes instead of trusting the snapshot it started
+        from. Both matter once a filesystem is parked at the watermark. Evicting exactly the
+        deficit leaves the next write facing the same edge, so every write pays an eviction;
+        and a filesystem's free count trails its own unlinks -- a journal commit, delayed
+        allocation, a write still in flight -- so a verify taken immediately after those
+        unlinks can refuse a write whose victims are already gone, which is the one outcome
+        worse than either alternative: the old pages are lost and the new page is dropped
+        too. Overshooting turns that into one burst per slack, and re-probing lets a later
+        round admit the write the burst made room for.
+
+        A round that evicts nothing ends it: that is the honest "nothing left to give", and
+        it is also what keeps this bounded when the space is held by files the evictor does
+        not own.
+        """
