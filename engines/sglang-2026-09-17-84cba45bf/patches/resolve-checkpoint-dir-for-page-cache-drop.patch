+def _checkpoint_dir(model_path: str) -> str:
+    """The directory the safetensors are in.
+
+    ``--model-path`` is a repo id whenever the server downloads its own weights, and the
+    files then live in the HF cache under ``--download-dir``, where globbing the repo id
+    matches nothing.
+    """
+    if os.path.isdir(model_path):
+        return model_path
+    from sglang.srt.model_loader.weight_utils import (
+        _find_local_hf_snapshot_dir_unlocked,
+    )
+
+    model = get_model()
+    snapshot = _find_local_hf_snapshot_dir_unlocked(
+        model_path, model.download_dir, ["*.safetensors"], model.revision
+    )
+    return snapshot or model_path
+
